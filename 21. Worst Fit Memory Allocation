#include <stdio.h>

int main()
{
    int block[20], process[20];
    int b, p, i, j;
    int allocation[20];

    printf("Enter number of memory blocks: ");
    scanf("%d", &b);

    printf("Enter number of processes: ");
    scanf("%d", &p);

    printf("Enter sizes of memory blocks:\n");
    for(i = 0; i < b; i++)
        scanf("%d", &block[i]);

    printf("Enter sizes of processes:\n");
    for(i = 0; i < p; i++)
        scanf("%d", &process[i]);

    for(i = 0; i < p; i++)
        allocation[i] = -1;

    for(i = 0; i < p; i++)
    {
        int worst = -1;

        for(j = 0; j < b; j++)
        {
            if(block[j] >= process[i])
            {
                if(worst == -1 || block[j] > block[worst])
                    worst = j;
            }
        }

        if(worst != -1)
        {
            allocation[i] = worst;
            block[worst] -= process[i];
        }
    }

    printf("\nProcess\tBlock\n");
    for(i = 0; i < p; i++)
    {
        if(allocation[i] != -1)
            printf("%d\t%d\n", i + 1, allocation[i] + 1);
        else
            printf("%d\tNot Allocated\n", i + 1);
    }

    return 0;
}
