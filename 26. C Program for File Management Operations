#include <stdio.h>

int main()
{
    FILE *fp;
    char text[100];

    fp = fopen("file.txt", "w");

    if (fp == NULL)
    {
        printf("Cannot create file\n");
        return 1;
    }

    printf("Enter text to store in file: ");
    scanf(" %[^\n]", text);

    fprintf(fp, "%s", text);

    fclose(fp);

    fp = fopen("file.txt", "r");

    if (fp == NULL)
    {
        printf("Cannot open file\n");
        return 1;
    }

    fscanf(fp, " %[^\n]", text);

    printf("File Content: %s\n", text);

    fclose(fp);

    return 0;
}
