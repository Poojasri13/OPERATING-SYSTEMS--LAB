#include <stdio.h>

int main()
{
    int indexBlock;
    int n, i;
    int blocks[20];

    printf("Enter index block: ");
    scanf("%d", &indexBlock);

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &blocks[i]);
    }

    printf("Index Block: %d\n", indexBlock);

    printf("Allocated Blocks:\n");
    for(i = 0; i < n; i++)
    {
        printf("%d ", blocks[i]);
    }

    return 0;
}
