#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, i;
    int request[20];
    int head;
    int total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &request[i]);
    }

    printf("Enter initial head position: ");
    scanf("%d", &head);

    for(i = 0; i < n; i++)
    {
        total = total + abs(request[i] - head);
        head = request[i];
    }

    printf("Total Seek Time = %d\n", total);

    return 0;
}
