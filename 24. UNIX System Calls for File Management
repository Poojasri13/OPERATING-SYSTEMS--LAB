#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char data[100];

    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);

    if(fd < 0)
    {
        printf("File could not be opened\n");
        return 1;
    }

    printf("Enter text to write into the file: ");
    scanf(" %[^\n]", data);

    write(fd, data, sizeof(data));

    lseek(fd, 0, SEEK_SET);

    read(fd, data, sizeof(data));

    printf("Contents of file: %s\n", data);

    close(fd);

    return 0;
}
